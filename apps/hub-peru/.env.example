# Copiar a .env (no versionado) y completar con los valores reales del
# app registration de Entra ID para HUB Perú.

# Application (client) ID del registro de la app en Entra ID.
VITE_ENTRA_CLIENT_ID=

# Directory (tenant) ID de Entra ID del directorio GEB.
VITE_ENTRA_TENANT_ID=

# URI de redirección registrada en Entra ID (debe coincidir exactamente).
VITE_ENTRA_REDIRECT_URI=http://localhost:5174

# Scope de la API backend del proyecto (p. ej. api://<id>/acceso).
VITE_API_SCOPE=

# Base URL del API backend (la consume @geb/api-client, no MSAL).
# hub-peru/backend todavía no existe — dejar apuntando a un mock/localhost
# hasta que haya un backend real.
VITE_API_BASE_URL=http://localhost:8080

# SOLO DESARROLLO — simula una sesión ya autenticada (rol RRHH_FILIAL) sin
# pasar por Entra ID, mientras no tengas las 4 variables de arriba. Muestra un
# banner "MODO DEV" bien visible. NUNCA activar en producción. Default: apagado.
VITE_DEV_MOCK_AUTH=false
